footer#contact.footer
  .container
    .footer__top
      .footer__links
        each col in footerColumns
          nav.footer__col
            h2.footer__title= col.title
            ul
              each link in col.links
                li
                  a(href=link.href)= link.label

      .newsletter
        h2.footer__title Newsletter
        form.newsletter__form(action='#', method='get')
          p.newsletter__text Fresh case studies and design notes, once a month.
          .field
            .field__row
              label.visually-hidden(for='email') Your email address
              input#email.input(
                type='email',
                name='email',
                placeholder='Your email address',
                required,
                aria-describedby='email-error'
              )
              button.btn.btn--primary(type='submit') Subscribe
            p#email-error.field__error Please enter a valid email address.
          label.check
            input(type='checkbox', name='consent', required)
            span I agree to the privacy policy

    .footer__bottom
      p.footer__copy &copy; 2026 Keepsake. All rights reserved.
      ul.socials
        each social in socials
          li
            a(href=social.href, aria-label=social.label)
              +icon(social.name)
